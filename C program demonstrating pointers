#include <stdio.h>

int main() {
    int a = 10, *ptr;

    printf("Enter the value of a: ");
    scanf("%d", &a);

    ptr = &a;

    printf("Value of a = %d\n", a);
    printf("Address of a = %p\n", (void*)&a);
    printf("Value of ptr (address of a) = %p\n", (void*)ptr);
    printf("Value of ptr (Dereferencing ptr) = %d\n", *ptr);

    return 0;
}
